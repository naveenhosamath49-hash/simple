# ==============================================================================
# AI News Intelligence Agent - Environment Configuration Example
# Copy this file to .env and populate with your own credentials.
# NEVER commit .env to version control.
# ==============================================================================

# News API Configuration (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# NVIDIA NIM API Configuration (https://build.nvidia.com / https://docs.api.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Supported options include:
# - meta/llama-3.3-70b-instruct
# - meta/llama-3.1-70b-instruct
# - meta/llama-3.1-8b-instruct
# - mistralai/mixtral-8x22b-instruct
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Database Configuration
# SQLite for local dev: sqlite:///./news_intelligence.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/news_db
DATABASE_URL=sqlite:///./news_intelligence.db

# Ingestion & Processing Settings
INGESTION_INTERVAL_MINUTES=30
MAX_ARTICLES_PER_FETCH=50
DEDUPLICATION_SIMILARITY_THRESHOLD=0.82
MAX_ARTICLE_CONTENT_LENGTH=6000

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
BACKEND_API_URL=http://localhost:8000
